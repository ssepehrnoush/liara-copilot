# Liara management API token (console.liara.ir > API). Never commit the real value.
LIARA_API_TOKEN=
# If the credit is on a team, put the team id here (list them with GET https://api.liara.ir/v2/teams)
LIARA_TEAM_ID=
# real = api.liara.ir, sim = local simulator with the same interface (no credit needed)
LIARA_MODE=real

# LLM (OpenAI-compatible). The chosen provider (the sponsor gateway BoxAPI) answers first; if it fails
# (budget, 429, timeout, 5xx) the LLM_FALLBACK provider answers. LLM_FALLBACK=none turns that off.
# With no model left the copilot uses its rule mode.
LLM_PROVIDER=boxapi
BOXAPI_KEY=
BOXAPI_MODEL=openai/gpt-6-sol
# For open-weight models on BoxAPI (see /paths.html): none | low | medium | high, or off.
# Measured: deepseek-v4-flash none, qwen3.6-35b-a3b off, gpt-oss-120b medium (low fails).
LLM_REASONING=
LLM_FALLBACK=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# api.openai.com blocks Iranian IPs; for local dev point this at your VPN's HTTP proxy
OPENAI_PROXY=

# Optional
COPILOT_PORT=4100
# Listens on this computer only; set HOST=0.0.0.0 (with COPILOT_PASSCODE) to serve it to others
HOST=127.0.0.1
# Protect the UI when the copilot itself is hosted publicly
COPILOT_PASSCODE=
# Extra apps (comma separated) the copilot may change; others stay read-only
COPILOT_ALLOWED_APPS=
WATCH_INTERVAL_SEC=20
